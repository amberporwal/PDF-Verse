# --- Backend (Render/Railway) env vars ---
# PORT Render khud set karta hai; local me 5000
PORT=5000
# Netlify site ka URL (comma se multiple allowed)
CLIENT_ORIGIN=https://your-site-name.netlify.app,http://localhost:5173
# Docker image me ye already set hain:
# CHROME_PATH=/usr/bin/chromium
# SOFFICE_PATH=/usr/bin/soffice

# --- Netlify env var (Site settings > Environment variables) ---
# VITE_API_URL=https://pdf-verse-api.onrender.com
